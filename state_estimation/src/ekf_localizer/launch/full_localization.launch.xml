<launch>
	<arg name="rviz" default="false" description="차에서 rviz2 실행 여부 (초기 포즈용)" />
	<arg name="imu_mux_mode" default="vesc"/>
	<arg name="weight_vesc" default="50.0"/>
	<arg name="imu_mux_weight_vesc" default="$(var weight_vesc)"/>
	<arg name="imu_mux_livox_bias_wz" default="0.01"/>
	<arg name="imu_mux_timeout_sec" default="0.1"/>
	<arg name="enable_imu_mux_csv" default="true"/>
	<arg name="imu_mux_csv_dir" default="/home/misys/forza_ws/race_stack/plusresult"/>
	<include file="$(find-pkg-share odom_to_twist_converter)/launch/odom_to_twist_converter.launch.xml" />
	<include file="$(find-pkg-share gyro_odometer)/launch/gyro_odometer.launch.xml">
		<arg name="imu_mux_mode" value="$(var imu_mux_mode)"/>
		<arg name="weight_vesc" value="$(var weight_vesc)"/>
		<arg name="imu_mux_weight_vesc" value="$(var imu_mux_weight_vesc)"/>
		<arg name="imu_mux_livox_bias_wz" value="$(var imu_mux_livox_bias_wz)"/>
		<arg name="imu_mux_timeout_sec" value="$(var imu_mux_timeout_sec)"/>
		<arg name="enable_imu_mux_csv" value="$(var enable_imu_mux_csv)"/>
		<arg name="imu_mux_csv_dir" value="$(var imu_mux_csv_dir)"/>
	</include>
	<include file="$(find-pkg-share ekf_localizer)/launch/ekf_localizer.launch.xml" />
	<include file="$(find-pkg-share lidarslam)/launch/localization.launch.py">
		<arg name="rviz" value="$(var rviz)" />
	</include>
	<include file="$(find-pkg-share carstate_3d)/launch/carstate_3d_launch.py"/>
</launch>
