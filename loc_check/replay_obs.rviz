Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Perception1
        - /Planner1
      Splitter Ratio: 0.5
    Tree Height: 780
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: false
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset: {X: 0, Y: 0, Z: 0}
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: false
    - Class: rviz_default_plugins/TF
      Enabled: false
      Frame Timeout: 15
      Frames: {All Enabled: true}
      Marker Scale: 0.5
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Tree: {}
      Update Interval: 0
      Value: false

    # 맵 — bag 에 없으므로 replay_obs.sh 가 map.pcd 에서 직접 발행한다
    - Alpha: 0.3
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds: {Max Value: 10, Min Value: -10, Value: true}
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 130; 130; 130
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: Map (pcd)
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 1
      Size (m): 0.01
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /map
      Use Fixed Frame: true
      Use rainbow: true
      Value: true

    # ---------------- 퍼셉션 ----------------
    - Class: rviz_common/Group
      Displays:
        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Name: 1) Detected obstacles (raw, 빨간 네모)
          Namespaces: {}
          Topic:
            Depth: 20
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /perception/detection/obstacles_markers
          Value: true
        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Name: 2) Tracked obstacles (초록=정적 자홍=미정 빨강=동적)
          Namespaces: {}
          Topic:
            Depth: 20
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /perception/static_dynamic_marker_pub
          Value: true
        - Class: rviz_default_plugins/Marker
          Enabled: true
          Name: Detection boundary (트랙 경계)
          Namespaces: {}
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /perception/detect_bound
          Value: true
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Class: rviz_default_plugins/LaserScan
          Color: 255; 170; 0
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Max Intensity: 4096
          Min Color: 0; 0; 0
          Min Intensity: 0
          Name: Scan
          Position Transformer: XYZ
          Selectable: false
          Size (Pixels): 3
          Size (m): 0.02
          Style: Points
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /scan
          Use Fixed Frame: true
          Use rainbow: false
          Value: true
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds: {Max Value: 10, Min Value: -10, Value: true}
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 80; 80; 255
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: false
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Max Intensity: 4096
          Min Color: 0; 0; 0
          Min Intensity: 0
          Name: Raw LiDAR (무거움)
          Position Transformer: XYZ
          Selectable: false
          Size (Pixels): 1
          Size (m): 0.01
          Style: Points
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /livox/lidar
          Use Fixed Frame: true
          Use rainbow: false
          Value: false
      Enabled: true
      Name: Perception

    # ---------------- 플래너 ----------------
    - Class: rviz_common/Group
      Displays:
        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Name: 3) Local path (초록, 높이=속도)
          Namespaces: {}
          Topic:
            Depth: 20
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /local_waypoints/markers
          Value: true
        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Name: 4) Avoidance spline (연보라)
          Namespaces: {}
          Topic:
            Depth: 20
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /planner/avoidance/markers
          Value: true
        - Class: rviz_default_plugins/Marker
          Enabled: true
          Name: Blocked zone (빨간 선)
          Namespaces: {}
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /planner/avoidance/propagated_obs
          Value: true
      Enabled: true
      Name: Planner

    # ---------------- 상태 / 자차 ----------------
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: State (초록GB 파랑TRAIL 흰OVERTAKE)
      Namespaces: {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /state_marker
      Value: true
    - Angle Tolerance: 0.10000000149011612
      Class: rviz_default_plugins/Odometry
      Covariance:
        Orientation: {Alpha: 0.5, Color: "255; 255; 127", Color Style: Unique, Frame: Local, Offset: 1, Scale: 1, Value: false}
        Position: {Alpha: 0.3, Color: "204; 51; 204", Scale: 1, Value: false}
        Value: false
      Enabled: true
      Keep: 1
      Name: Ego
      Position Tolerance: 0.10000000149011612
      Shape:
        Alpha: 1
        Axes Length: 1
        Axes Radius: 0.10000000149011612
        Color: 255; 25; 0
        Head Length: 0.15000000596046448
        Head Radius: 0.10000000149011612
        Shaft Length: 0.30000001192092896
        Shaft Radius: 0.03999999910593033
        Value: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /car_state/odom
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 18
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point: {X: 0, Y: 0, Z: 0}
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 1.5697963237762451
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 4.71238899230957
    Saved: ~
Window Geometry:
  Displays: {collapsed: false}
  Height: 1016
  Hide Left Dock: false
  Hide Right Dock: true
  Views: {collapsed: true}
  Width: 1848
  X: 72
  Y: 27
